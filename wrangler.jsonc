{
  // El sitio estático se sirve desde ./public. El Worker SOLO se ejecuta
  // para las rutas de video (run_worker_first), que se sirven desde el
  // bucket R2 "bluelatitude" con soporte nativo de HTTP Range (206),
  // necesario para el scrubbing de video por scroll.
  "name": "blue-latitude",
  "compatibility_date": "2026-06-01",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/videos/*"]
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "bluelatitude" }
  ]
}
